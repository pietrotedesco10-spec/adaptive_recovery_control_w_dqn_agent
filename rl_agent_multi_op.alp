				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789000040011</Id>
					<Name><![CDATA[isNextScheduledTaskReady]]></Name>
					<X>500</X><Y>2067</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return false;
}

String[] row = peekNextScheduledRowForOperator(getOperatorFullName(op));
return row != null
    && row.length >= 2
    && isScheduledTaskReady(row[1]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789000040006</Id>
					<Name><![CDATA[getPredictedFatigueAfterTwoTasks]]></Name>
					<X>500</X><Y>2102</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return 0.0;
}

double firstFatigue = getPredictedFatigueAfterNextTask(op);

// Natural idle is already a recovery opportunity, so planning stops there.
if (getNextTaskTypeCode(op) == 0.0 || getSecondTaskTypeCode(op) == 0.0) {
    return firstFatigue;
}

String[] row = peekSecondScheduledRowForOperator(getOperatorFullName(op));
double durationMinutes = Math.max(
    0.0,
    Double.parseDouble(row[2]) + taskProcessingTimeSigma
);
double baseDurationSeconds = Math.max(0.001, durationMinutes * 60.0);
double lambda = Math.max(0.0, Double.parseDouble(row[3]));

double f = Math.max(0.0, Math.min(0.999999, firstFatigue));
double fatigueCoefficient = f <= 0.25 ? 1.0 : 0.75 + f;
double effectiveDurationSeconds = baseDurationSeconds * fatigueCoefficient;
double shiftProgress = standardShiftHours > 0.0
    ? getElapsedShiftHours() / standardShiftHours
    : 0.0;
shiftProgress = Math.max(0.0, Math.min(1.0, shiftProgress));

double effectiveLambda =
    lambda
    * op.fatigueRateMultiplier
    * (1.0 + 0.05 * shiftProgress);

double predictedFatigue =
    f + (1.0 - f)
    * (1.0 - Math.exp(-effectiveLambda * effectiveDurationSeconds));

return Math.max(0.0, Math.min(1.0, predictedFatigue));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1778073411069</Id>
					<Name><![CDATA[getCurrentState]]></Name>
					<X>500</X><Y>2137</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentOperator == null) {
    return "";
}

currentOperator.updateShiftTracking();

double currentFatigue = currentOperator.fatigue;
double currentTimeSinceLastRecovery =
    Math.max(0.0, time() - currentOperator.lastRecoveryTime);

double timeToReachHy = getTimeToReachHy(currentFatigue);

int operatorType = 0;
if ("B".equals(currentOperator.stationName)) {
    operatorType = 1;
}
else if ("C".equals(currentOperator.stationName)) {
    operatorType = 2;
}
int operatorAOnBreak = (
    operatorA != null
    && (operatorA.onBreak || operatorA.recoveryRequested)
) ? 1 : 0;

int operatorBOnBreak = (
    operatorB != null
    && (operatorB.onBreak || operatorB.recoveryRequested)
) ? 1 : 0;

int operatorCOnBreak = (
    operatorC != null
    && (operatorC.onBreak || operatorC.recoveryRequested)
) ? 1 : 0;

int numberOperatorsOnBreak =
    operatorAOnBreak + operatorBOnBreak + operatorCOnBreak;

int currentOperatorOnBreak = 0;

if ("A".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorAOnBreak;
}
else if ("B".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorBOnBreak;
}
else if ("C".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorCOnBreak;
}
int otherOperatorOnBreak =
    (numberOperatorsOnBreak - currentOperatorOnBreak) > 0 ? 1 : 0;

double fatigueA = operatorA != null ? operatorA.fatigue : 0.0;
double fatigueB = operatorB != null ? operatorB.fatigue : 0.0;
double fatigueC = operatorC != null ? operatorC.fatigue : 0.0;

int numberOperatorsWorking =
    (operatorA != null && operatorA.isWorking ? 1 : 0)
    + (operatorB != null && operatorB.isWorking ? 1 : 0)
    + (operatorC != null && operatorC.isWorking ? 1 : 0);

double globalAverageFatigue = (fatigueA + fatigueB + fatigueC) / 3.0;
double globalMaxFatigue = Math.max(fatigueA, Math.max(fatigueB, fatigueC));
double globalMinFatigue = Math.min(fatigueA, Math.min(fatigueB, fatigueC));
double fatigueImbalance = globalMaxFatigue - globalMinFatigue;
double nextTaskType = getNextTaskTypeCode(currentOperator);
double nextTaskDuration = getNextTaskDuration(currentOperator);
double predictedFatigueAfterNextTask =
    getPredictedFatigueAfterNextTask(currentOperator);
double secondTaskType = getSecondTaskTypeCode(currentOperator);
double predictedFatigueAfterTwoTasks =
    getPredictedFatigueAfterTwoTasks(currentOperator);
double timeToNextIdle = getTimeToNextScheduledIdle(currentOperator);
double nextIdleDuration = getNextScheduledIdleDuration(currentOperator);
double remainingScheduledDuration =
    getRemainingScheduledDuration(currentOperator);
double secondTaskDuration = getSecondTaskDuration(currentOperator);
int nextTaskReady = isNextScheduledTaskReady(currentOperator) ? 1 : 0;

return String.format(
    java.util.Locale.US,
    "%d,%d,%d,%.4f,%.6f,%.4f,%.4f,%d,%d,%.4f,%.6f,%d,%.6f,%.6f,%.6f,%d,%d,%d,%d,%.6f,%.6f,%.6f,%.6f,%.1f,%.4f,%.6f,%.1f,%.6f,%.4f,%.4f,%.4f,%.4f,%d",
    operatorType,
    numberLongRecoveries,
    numberAdaptiveRecoveries,
    currentTimeSinceLastRecovery,
    currentFatigue,
    timeToReachHy,
    lastServiceTime,
    otherOperatorOnBreak,
    numberOperatorsOnBreak,
    currentOperator.workTime,
    currentOperator.tdNormCumsumCurrentShift,
    currentOperator.lastJobHadBreak,
    fatigueA,
    fatigueB,
    fatigueC,
    operatorAOnBreak,
    operatorBOnBreak,
    operatorCOnBreak,
    numberOperatorsWorking,
    globalAverageFatigue,
    globalMaxFatigue,
    globalMinFatigue,
    fatigueImbalance,
    nextTaskType,
    nextTaskDuration,
    predictedFatigueAfterNextTask,
    secondTaskType,
    predictedFatigueAfterTwoTasks,
    timeToNextIdle,
    nextIdleDuration,
    remainingScheduledDuration,
    secondTaskDuration,
    nextTaskReady
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778076130081</Id>
					<Name><![CDATA[makeRecoveryDecision]]></Name>
					<X>880</X><Y>1612</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return;
}

if (op.onBreak) {
    return;
}

// Do not request recovery after the operator has completed the schedule.
if (useFixedTaskSchedule && getRemainingScheduledDuration(op) <= 0.0) {
    return;
}

// A blocked successor already creates natural recovery time. Recovery is not
// a valid decision until the precedence constraint releases the next task.
if (
    useFixedTaskSchedule
    && experimentMode != 1
    && !isNextScheduledTaskReady(op)
) {
    return;
}

// Operator that completed the latest job.
currentOperator = op;

String region = getFatigueRegion(op.fatigue);

int action = 0;

// Baseline policies are deterministic and do not call Python.
if (experimentMode == 1) {
    action = selectBaselineAction();

    if (action != 0) {
        addDecisionLogRow(region, action, "decision");
        applyAgentAction(action);
    }

    return;
}

// Decisions are needed only from Hx upwards.
if (region.equals("A")) {
    return;
}

if (experimentMode == 2) {
    action = selectExplorationAction();
}
else if (experimentMode == 3) {
    // Pure DQN: the Python action is executed without overrides or fallback.
    action = selectRLAction();
}
else {
    return;
}

addDecisionLogRow(region, action, "decision");

if (action != 0) {
    applyAgentAction(action);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1778334081731</Id>
					<Name><![CDATA[selectBaselineAction]]></Name>
					<X>880</X><Y>1682</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentOperator == null) {
    return 0;
}

double f = currentOperator.fatigue;

// Baseline 1 is the no-recovery reference case.
if (baselinePolicyType == 1) {
    return 0;
}

// Threshold baseline: recover only after a completed task reaches Hy.
if (baselinePolicyType == 2) {
    return f >= Hy ? 2 : 0;
}

// GA 60/40 baseline: follow the precomputed static work-rest plan.
if (baselinePolicyType == 3) {
    return selectStaticGaRecoveryAction(currentOperator);
}

return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1778334111650</Id>
					<Name><![CDATA[selectExplorationAction]]></Name>
					<X>880</X><Y>1717</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentOperator == null) {
    return 0;
}

double f = currentOperator.fatigue;

if (f < Hx) {
    return 0;
}

double r = uniform(0, 1);

// Lower fatigue: sample all actions uniformly.
if (f < 0.70) {
    if (r < 1.0 / 3.0) return 0;
    if (r < 2.0 / 3.0) return 1;
    return 2;
}

// Near Hy: retain unsafe examples while favouring recovery.
if (f < Hy) {
    if (r < 0.20) return 0;
    if (r < 0.60) return 1;
    return 2;
}

// Above Hy: collect a few negative examples and recover promptly.
if (r < 0.10) return 0;
if (r < 0.30) return 1;
return 2;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1778334124955</Id>
					<Name><![CDATA[selectRLAction]]></Name>
					<X>880</X><Y>1752</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentOperator == null) {
    return 0;
}

// Request the DQN action.
String currentStateStr = getCurrentState();
traceln("Python request at time: " + time() + " | State: " + currentStateStr);

int action = exchangeSocketAction(currentStateStr);
traceln("Python action: " + action);

return action;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1778335007478</Id>
					<Name><![CDATA[getActionType]]></Name>
					<X>880</X><Y>1857</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (action == 0) {
    return "continue_working";
}
else if (action == 1) {
    return "short_break";
}
else if (action == 2) {
    return "long_break";
}
else {
    return "unknown";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778335049246</Id>
					<Name><![CDATA[addDecisionLogRow]]></Name>
					<X>1200</X><Y>1787</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[region]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[recordType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (currentOperator == null) {
    return;
}

String operatorName = "OperatorUnknown";
String station = "Unknown";

if ("A".equals(currentOperator.stationName)) {
    operatorName = "OperatorA";
    station = "A";
}
else if ("B".equals(currentOperator.stationName)) {
    operatorName = "OperatorB";
    station = "B";
}
else if ("C".equals(currentOperator.stationName)) {
    operatorName = "OperatorC";
    station = "C";
}
double currentFatigue = currentOperator.fatigue;
double currentTimeSinceLastRecovery =
    Math.max(0.0, time() - currentOperator.lastRecoveryTime);

double distanceFromHx = currentFatigue - Hx;
double distanceFromHy = currentFatigue - Hy;

double timeToReachHy = getTimeToReachHy(currentFatigue);

    int queueLength = queueA.size() + queueB.size() + queueC.size();

String actionType = "recovery_end".equals(recordType)
    ? "observation"
    : getActionType(action);

double loggedLastServiceTime = "recovery_end".equals(recordType)
    ? 0.0
    : lastServiceTime;

int operatorAOnBreak = (
    operatorA != null
    && (operatorA.onBreak || operatorA.recoveryRequested)
) ? 1 : 0;

int operatorBOnBreak = (
    operatorB != null
    && (operatorB.onBreak || operatorB.recoveryRequested)
) ? 1 : 0;

int operatorCOnBreak = (
    operatorC != null
    && (operatorC.onBreak || operatorC.recoveryRequested)
) ? 1 : 0;

int numberOperatorsOnBreak =
    operatorAOnBreak + operatorBOnBreak + operatorCOnBreak;

int currentOperatorOnBreak = 0;

if ("A".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorAOnBreak;
}
else if ("B".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorBOnBreak;
}
else if ("C".equals(currentOperator.stationName)) {
    currentOperatorOnBreak = operatorCOnBreak;
}
int otherOperatorOnBreak =
    (numberOperatorsOnBreak - currentOperatorOnBreak) > 0 ? 1 : 0;

int operatorType = 0;
if ("B".equals(currentOperator.stationName)) {
    operatorType = 1;
}
else if ("C".equals(currentOperator.stationName)) {
    operatorType = 2;
}
double currentWorkTime = currentOperator.workTime;

double fatigueA = operatorA != null ? operatorA.fatigue : 0.0;
double fatigueB = operatorB != null ? operatorB.fatigue : 0.0;
double fatigueC = operatorC != null ? operatorC.fatigue : 0.0;

int numberOperatorsWorking =
    (operatorA != null && operatorA.isWorking ? 1 : 0)
    + (operatorB != null && operatorB.isWorking ? 1 : 0)
    + (operatorC != null && operatorC.isWorking ? 1 : 0);

double globalAverageFatigue = (fatigueA + fatigueB + fatigueC) / 3.0;
double globalMaxFatigue = Math.max(fatigueA, Math.max(fatigueB, fatigueC));
double globalMinFatigue = Math.min(fatigueA, Math.min(fatigueB, fatigueC));
double fatigueImbalance = globalMaxFatigue - globalMinFatigue;
double nextTaskType = getNextTaskTypeCode(currentOperator);
double nextTaskDuration = getNextTaskDuration(currentOperator);
double predictedFatigueAfterNextTask =
    getPredictedFatigueAfterNextTask(currentOperator);
double secondTaskType = getSecondTaskTypeCode(currentOperator);
double predictedFatigueAfterTwoTasks =
    getPredictedFatigueAfterTwoTasks(currentOperator);
double timeToNextIdle = getTimeToNextScheduledIdle(currentOperator);
double nextIdleDuration = getNextScheduledIdleDuration(currentOperator);
double remainingScheduledDuration =
    getRemainingScheduledDuration(currentOperator);
double secondTaskDuration = getSecondTaskDuration(currentOperator);
int nextTaskReady = isNextScheduledTaskReady(currentOperator) ? 1 : 0;

String row = String.format(
    java.util.Locale.US,
    "%.4f,%s,%s,%d,%d,%s,%d,%s,%s,%d,%d,%.4f,%.6f,%.6f,%.6f,%.4f,%d,%d,%d,%d,%d,%.4f,%d,%d,%d,%d,%d,%.4f,%.6f,%d,%.6f,%.6f,%.6f,%d,%.6f,%.6f,%.6f,%.6f,%.1f,%.4f,%.6f,%.1f,%.6f,%.4f,%.4f,%.4f,%.4f,%d,%s\n",
    time(),
    operatorName,
    station,
    operatorType,
    experimentMode,
    region,
    action,
    actionType,
    recordType,
    numberLongRecoveries,
    numberAdaptiveRecoveries,
    currentTimeSinceLastRecovery,
    currentFatigue,
    distanceFromHx,
    distanceFromHy,
    timeToReachHy,
    queueLength,
    completedJobs,
    completedJobsA,
    completedJobsB,
    completedJobsC,
    loggedLastServiceTime,
    operatorAOnBreak,
    operatorBOnBreak,
    operatorCOnBreak,
    otherOperatorOnBreak,
    numberOperatorsOnBreak,
    currentWorkTime,
    currentOperator.tdNormCumsumCurrentShift,
	currentOperator.lastJobHadBreak,
    fatigueA,
    fatigueB,
    fatigueC,
    numberOperatorsWorking,
    globalAverageFatigue,
    globalMaxFatigue,
    globalMinFatigue,
    fatigueImbalance,
    nextTaskType,
    nextTaskDuration,
    predictedFatigueAfterNextTask,
    secondTaskType,
    predictedFatigueAfterTwoTasks,
    timeToNextIdle,
    nextIdleDuration,
    remainingScheduledDuration,
    secondTaskDuration,
    nextTaskReady,
    activeExplorationScheduleId
);

rlDecisionLog += row;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778335116390</Id>
					<Name><![CDATA[exportRlDecisionLog]]></Name>
					<X>1200</X><Y>1857</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String decisionLogName = "";

    if (experimentMode == 1 && baselinePolicyType == 1) {
        decisionLogName = "rl_decision_log_no_recovery.csv";
    }
    else if (experimentMode == 1 && baselinePolicyType == 2) {
        decisionLogName = "rl_decision_log_threshold_recovery.csv";
    }
    else if (experimentMode == 1 && baselinePolicyType == 3) {
        decisionLogName = "rl_decision_log_work60_recovery40.csv";
    }
    else if (experimentMode == 2) {
        decisionLogName = "rl_decision_log_exploration.csv";
    }
    else if (experimentMode == 3) {
        decisionLogName = "rl_decision_log_dqn_adaptive_recovery.csv";
    }
    else {
        decisionLogName = "rl_decision_log.csv";
    }

    // Use the same simulationSeed used in exportRlEventLog for consistent pairing.
    String _seedSuffix2 = "_s" + simulationSeed;
    String _decBase    = decisionLogName.replace(".csv", "");
    String filePath    = "C:/Users/pietr/Desktop/fatigue_rl_agent/data/anylogic_logs/" + _decBase + _seedSuffix2 + ".csv";

    java.io.PrintWriter writer = new java.io.PrintWriter(filePath, "UTF-8");
    writer.print(rlDecisionLog);
    writer.close();

    traceln("RL decision log exported to: " + filePath);

} catch (Exception e) {
    traceln("Error exporting RL decision log: " + e);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778595751605</Id>
					<Name><![CDATA[getSimulationDurationMinutes]]></Name>
					<X>200</X><Y>1047</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (experimentMode == 2) {
    // Exploration mode uses the configured training horizon.
    return explorationSimulationHours * 60.0;
}

// Baseline and agent runs use the standard shift duration for reporting.
// Fixed schedules terminate independently through finishIfFixedScheduleCompleted().
return standardShiftHours * 60.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1778925327218</Id>
					<Name><![CDATA[exchangeSocketAction]]></Name>
					<X>880</X><Y>1822</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[state]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.net.Socket socket = new java.net.Socket();
try {
    // Prevent an indefinite wait if the DQN server is unavailable.
    socket.connect(
        new java.net.InetSocketAddress("127.0.0.1", 5005),
        2000
    );
    socket.setSoTimeout(3000);

    java.io.PrintWriter out =
        new java.io.PrintWriter(socket.getOutputStream(), true);
    java.io.BufferedReader in =
        new java.io.BufferedReader(
            new java.io.InputStreamReader(socket.getInputStream())
        );

    out.println(state);

    String response = in.readLine();
    if (response == null) {
        throw new java.io.IOException("DQN server returned no action.");
    }

    int action = Integer.parseInt(response.trim());
    if (action < 0 || action > 2) {
        throw new IllegalArgumentException(
            "DQN server returned invalid action: " + action
        );
    }
    return action;

} catch (Exception e) {
    throw new RuntimeException(
        "DQN communication failed. Mode 3 cannot continue without the policy.",
        e
    );
} finally {
    try {
        socket.close();
    } catch (Exception ignored) {
        // Socket cleanup is best effort.
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779440240993</Id>
					<Name><![CDATA[getElapsedShiftHours]]></Name>
					<X>200</X><Y>1082</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double shiftDurationMinutes = standardShiftHours * 60.0;

if (shiftDurationMinutes <= 0) {
    return time() / 60.0;
}

double elapsedShiftMinutes = time();

// In exploration mode, the long simulation is divided into repeated standard shifts.
if (experimentMode == 2) {
    elapsedShiftMinutes = time() % shiftDurationMinutes;
}
else {
    elapsedShiftMinutes = Math.min(time(), shiftDurationMinutes);
}

double elapsedShiftHours = elapsedShiftMinutes / 60.0;

return Math.min(elapsedShiftHours, standardShiftHours);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1779968072421</Id>
					<Name><![CDATA[getCurrentShiftID]]></Name>
					<X>200</X><Y>1117</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double shiftDurationMinutes = standardShiftHours * 60.0;

if (shiftDurationMinutes <= 0) {
    return 0;
}

return (int) Math.floor(time() / shiftDurationMinutes);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1787000020001</Id>
					<Name><![CDATA[loadStaticGaRecoveryPlan]]></Name>
					<X>860</X><Y>907</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (fixedTaskSchedule.isEmpty()) {
    loadFixedTaskSchedule();
}

String scheduleId = activeExplorationScheduleId;

// Only baseline 3 uses a precomputed GA recovery plan.
if (baselinePolicyType != 3) {
    staticGaRecoveryPlan.clear();
    staticGaRecoveryPlanScheduleId = "";
    return;
}

if (scheduleId == null || scheduleId.length() == 0) {
    scheduleId = "schedule_v2_01";
}

if (scheduleId.equals(staticGaRecoveryPlanScheduleId)) {
    return;
}

staticGaRecoveryPlan.clear();
staticGaRecoveryPlanScheduleId = scheduleId;

String planRatioSuffix = "_r40";

String planPath =
    System.getProperty("user.home") +
    "\\Desktop\\fatigue_rl_agent\\schedule\\simulation\\ga_recovery_plan_" +
    scheduleId +
    planRatioSuffix +
    ".csv";

try {
    java.io.BufferedReader reader =
        new java.io.BufferedReader(new java.io.FileReader(planPath));

    String line = reader.readLine(); // header

    while ((line = reader.readLine()) != null) {
        line = line.trim();

        if (line.length() == 0) {
            continue;
        }

        String[] parts = line.split(",");

        if (parts.length < 7 || !scheduleId.equals(parts[0].trim())) {
            continue;
        }

        String operatorName = parts[1].trim();
        int afterSequence = Integer.parseInt(parts[2].trim());
        int action = Integer.parseInt(parts[4].trim());

        if (action == 1 || action == 2) {
            staticGaRecoveryPlan.put(
                operatorName + "|" + afterSequence,
                action
            );
        }
    }

    reader.close();

    traceln(
        "Static GA recovery plan loaded: " +
        planPath +
        " | recovery points: " +
        staticGaRecoveryPlan.size()
    );
}
catch (Exception ex) {
    traceln(
        "WARNING: static GA recovery plan not loaded from " +
        planPath +
        ". The policy will continue without planned recovery."
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1787000020002</Id>
					<Name><![CDATA[selectStaticGaRecoveryAction]]></Name>
					<X>880</X><Y>1787</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return 0;
}

loadStaticGaRecoveryPlan();

String operatorName = getOperatorFullName(op);
int completedSequence =
    fixedTaskScheduleCompletedByOperator.containsKey(operatorName)
    ? fixedTaskScheduleCompletedByOperator.get(operatorName)
    : 0;

Integer action = staticGaRecoveryPlan.get(
    operatorName + "|" + completedSequence
);

return action != null ? action.intValue() : 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1784194301530</Id>
					<Name><![CDATA[loadFixedTaskSchedule]]></Name>
					<X>860</X><Y>732</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[fixedTaskSchedule.clear();
explorationSchedules.clear();
explorationScheduleIds.clear();
activeExplorationScheduleIndex = 0;
activeExplorationScheduleId = "";

String scheduleFileName = experimentMode == 2
    ? "schedule_training_merged.csv"
    : "schedule_v1_01.csv";

String scheduleDirectory = experimentMode == 2 ? "exploration" : "simulation";
String schedulePath =
    System.getProperty("user.home") +
    "\\Desktop\\fatigue_rl_agent\\schedule\\" +
    scheduleDirectory +
    "\\" +
    scheduleFileName;

java.util.LinkedHashMap<String, java.util.ArrayList<String[]>> rowsBySchedule =
    new java.util.LinkedHashMap<String, java.util.ArrayList<String[]>>();
java.util.HashMap<String, java.util.HashMap<String, Double>> clocksBySchedule =
    new java.util.HashMap<String, java.util.HashMap<String, Double>>();

try {
    java.io.BufferedReader reader =
        new java.io.BufferedReader(new java.io.FileReader(schedulePath));

    String line = reader.readLine(); // header

    while ((line = reader.readLine()) != null) {
        line = line.trim();

        if (line.length() == 0) {
            continue;
        }

        String[] parts = line.split(",");

        if (parts.length < 6) {
            continue;
        }

        String operatorName = parts[0].trim();
        String taskType = parts[3].trim();
        double durationSeconds = Double.parseDouble(parts[4].trim());
        double taskLambda = Double.parseDouble(parts[5].trim());
        String scheduleId = parts.length > 11 && parts[11].trim().length() > 0
            ? parts[11].trim()
            : "schedule_01";

        if (!"OperatorA".equals(operatorName)
            && !"OperatorB".equals(operatorName)
            && !"OperatorC".equals(operatorName)) {
            continue;
        }

        if (!"idle".equals(taskType) && !taskType.startsWith("job_")) {
            continue;
        }

        java.util.ArrayList<String[]> scheduleRows = rowsBySchedule.get(scheduleId);
        if (scheduleRows == null) {
            scheduleRows = new java.util.ArrayList<String[]>();
            rowsBySchedule.put(scheduleId, scheduleRows);
            clocksBySchedule.put(scheduleId, new java.util.HashMap<String, Double>());
        }

        java.util.HashMap<String, Double> operatorClockSeconds =
            clocksBySchedule.get(scheduleId);
        double startSeconds = operatorClockSeconds.containsKey(operatorName)
            ? operatorClockSeconds.get(operatorName)
            : 0.0;
        double endSeconds = startSeconds + durationSeconds;

        scheduleRows.add(new String[] {
            operatorName,
            taskType,
            String.valueOf(durationSeconds / 60.0),
            String.valueOf(taskLambda),
            String.valueOf(startSeconds / 60.0),
            String.valueOf(endSeconds / 60.0)
        });

        operatorClockSeconds.put(operatorName, endSeconds);
    }

    reader.close();
}
catch (Exception ex) {
    throw new RuntimeException(
        "Required schedule file could not be loaded: " + schedulePath,
        ex
    );
}

for (java.util.Map.Entry<String, java.util.ArrayList<String[]>> entry : rowsBySchedule.entrySet()) {
    java.util.ArrayList<String[]> scheduleRows = entry.getValue();
    scheduleRows.sort(new java.util.Comparator<String[]>() {
        public int compare(String[] a, String[] b) {
            return Double.compare(Double.parseDouble(a[4]), Double.parseDouble(b[4]));
        }
    });
    explorationScheduleIds.add(entry.getKey());
    explorationSchedules.add(scheduleRows);
}

if (!explorationSchedules.isEmpty()) {
    activateExplorationSchedule(0);
}

traceln(
    "Schedule file loaded. Scenarios: " +
    explorationSchedules.size() +
    " | active schedule: " +
    activeExplorationScheduleId +
    " | rows: " +
    fixedTaskSchedule.size()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1785000020001</Id>
					<Name><![CDATA[activateExplorationSchedule]]></Name>
					<X>860</X><Y>767</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[scheduleIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (scheduleIndex < 0 || scheduleIndex >= explorationSchedules.size()) {
    return;
}

activeExplorationScheduleIndex = scheduleIndex;
activeExplorationScheduleId = explorationScheduleIds.get(scheduleIndex);

fixedTaskSchedule.clear();
fixedTaskSchedule.addAll(explorationSchedules.get(scheduleIndex));
fixedTaskSchedule.sort(new java.util.Comparator<String[]>() {
    public int compare(String[] a, String[] b) {
        return Double.compare(Double.parseDouble(a[4]), Double.parseDouble(b[4]));
    }
});

fixedTaskScheduleIndex = 0;
fixedTaskScheduleCycle = scheduleIndex;
fixedTaskScheduleCycleMinutes = 0.0;
fixedTaskScheduleIndexByOperator.clear();
fixedTaskScheduleCompletedByOperator.clear();
completedScheduledActivities.clear();
precedenceWaitStartByOperator.clear();
activeScheduleStartTime = time();
scheduledDispatchOperatorName = "";
scheduledDispatchQueue.clear();
scheduledDispatchInFlight.clear();
initialScheduledDispatchDone = false;

for (String[] row : fixedTaskSchedule) {
    double endMinutes = row.length > 5
        ? Double.parseDouble(row[5])
        : Double.parseDouble(row[4]) + Double.parseDouble(row[2]);
    fixedTaskScheduleCycleMinutes = Math.max(
        fixedTaskScheduleCycleMinutes,
        endMinutes
    );
}

fixedTaskScheduleIndexByOperator.put("OperatorA", 0);
fixedTaskScheduleIndexByOperator.put("OperatorB", 0);
fixedTaskScheduleIndexByOperator.put("OperatorC", 0);

fixedTaskScheduleCompletedByOperator.put("OperatorA", 0);
fixedTaskScheduleCompletedByOperator.put("OperatorB", 0);
fixedTaskScheduleCompletedByOperator.put("OperatorC", 0);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1785000020002</Id>
					<Name><![CDATA[resetOperatorForExplorationSchedule]]></Name>
					<X>860</X><Y>802</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return;
}

op.fatigue = 0.0;
op.workTime = 0.0;
op.breakTime = 0.0;
op.idleTime = 0.0;
op.onBreak = false;
op.isWorking = false;
op.recoveryRequested = false;
op.selectedAction = 0;
op.recoveryDuration = 0.0;
op.recoveryStartTime = 0.0;
op.recoveryType = "none";
op.tdNormCumsumCurrentShift = 0.0;
op.hadBreakSinceLastJob = 0;
op.lastJobHadBreak = 0;
op.lastRecoveryTime = time();
op.lastTrackedShiftID = getCurrentShiftID();
op.updateHumanTwinState();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1785000020003</Id>
					<Name><![CDATA[resetExplorationScheduleState]]></Name>
					<X>860</X><Y>837</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[resetOperatorForExplorationSchedule(operatorA);
resetOperatorForExplorationSchedule(operatorB);
resetOperatorForExplorationSchedule(operatorC);

completedJobs = 0;
completedJobsA = 0;
completedJobsB = 0;
completedJobsC = 0;
totalJobTime = 0.0;
averageJobTime = 0.0;
lastServiceTime = 0.0;
fatigueSum = 0.0;
fatigueSamples = 0;
averageFatigue = 0.0;
maxFatigue = 0.0;
highFatigueTime = 0.0;
queueSum = 0.0;
queueSamples = 0;
averageQueueLength = 0.0;
maxQueueLength = 0;
numberOfRecoveries = 0;
numberLongRecoveries = 0;
numberAdaptiveRecoveries = 0;
lastRecoveryStartTime = time();
totalRecoveryTime = 0.0;
fatigueBeforeRecovery = 0.0;
totalFatigueReduction = 0.0;
recoveryEfficiency = 0.0;
currentJobStartTime = 0.0;
currentOperator = null;

OperatorPoolA.set_capacity(1);
OperatorPoolB.set_capacity(1);
OperatorPoolC.set_capacity(1);
holdA.unblock();
holdB.unblock();
holdC.unblock();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1785000020004</Id>
					<Name><![CDATA[startNextExplorationSchedule]]></Name>
					<X>860</X><Y>872</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int nextIndex = activeExplorationScheduleIndex + 1;

if (nextIndex >= explorationSchedules.size()) {
    return false;
}

activateExplorationSchedule(nextIndex);
resetExplorationScheduleState();

traceln(
    "EXPLORATION SCHEDULE RESET: " +
    activeExplorationScheduleId +
    " (" +
    (activeExplorationScheduleIndex + 1) +
    "/" +
    explorationSchedules.size() +
    ")"
);

// Dispatch the first activity of each active operator immediately.
initialScheduledDispatchDone = true;
dispatchNextScheduledTaskForOperator("A");
dispatchNextScheduledTaskForOperator("B");
dispatchNextScheduledTaskForOperator("C");

return true;]]></Body>
				</Function>
			</Functions>
