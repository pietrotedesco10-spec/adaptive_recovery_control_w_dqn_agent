			<Events>
				<Event>
					<Id>1777452997648</Id>
					<Name><![CDATA[monitorUpdate]]></Name>
					<X>1440</X><Y>1752</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1777452997646</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777536000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (operatorA != null) {
    fatigueOperatorA = operatorA.fatigue;
    humanTwinHealthA = operatorA.humanTwinHealthScore;
    humanTwinRiskLevelA = operatorA.humanTwinRiskLevel;
}

if (operatorB != null) {
    fatigueOperatorB = operatorB.fatigue;
    humanTwinHealthB = operatorB.humanTwinHealthScore;
    humanTwinRiskLevelB = operatorB.humanTwinRiskLevel;
}

if (operatorC != null) {
    fatigueOperatorC = operatorC.fatigue;
    humanTwinHealthC = operatorC.humanTwinHealthScore;
    humanTwinRiskLevelC = operatorC.humanTwinRiskLevel;
}

// Optional general monitor.
if (currentOperator != null) {
    fatigueMonitor = currentOperator.fatigue;
}

// Queue monitoring.
queueSum += queueA.size() + queueB.size() + queueC.size();
queueSamples++;

if (queueSamples > 0) {
    averageQueueLength = queueSum / queueSamples;
}

int totalQueueLength = queueA.size() + queueB.size() + queueC.size();

if (totalQueueLength > maxQueueLength) {
    maxQueueLength = totalQueueLength;
}

// Average fatigue of available monitored operators.
double fatigueTotal = 0.0;
int activeOperators = 0;

if (operatorA != null) {
    fatigueTotal += operatorA.fatigue;
    activeOperators++;
}

if (operatorB != null) {
    fatigueTotal += operatorB.fatigue;
    activeOperators++;
}

if (operatorC != null) {
    fatigueTotal += operatorC.fatigue;
    activeOperators++;
}

double averageCurrentFatigue = 0.0;

if (activeOperators > 0) {
    averageCurrentFatigue = fatigueTotal / activeOperators;
}

fatigueSum += averageCurrentFatigue;
fatigueSamples++;

if (fatigueSamples > 0) {
    averageFatigue = fatigueSum / fatigueSamples;
}

if (operatorA != null && operatorA.fatigue > maxFatigue) {
    maxFatigue = operatorA.fatigue;
}

if (operatorB != null && operatorB.fatigue > maxFatigue) {
    maxFatigue = operatorB.fatigue;
}

if (operatorC != null && operatorC.fatigue > maxFatigue) {
    maxFatigue = operatorC.fatigue;
}

if (averageCurrentFatigue >= Hy) {
    highFatigueTime += 1.0;
}

// Human Digital Twin monitoring.
double healthTotal = 0.0;
int healthOperators = 0;

if (operatorA != null) {
    healthTotal += operatorA.humanTwinHealthScore;
    healthOperators++;

    if (operatorA.humanTwinHealthScore < minHumanTwinHealth) {
        minHumanTwinHealth = operatorA.humanTwinHealthScore;
    }
}

if (operatorB != null) {
    healthTotal += operatorB.humanTwinHealthScore;
    healthOperators++;

    if (operatorB.humanTwinHealthScore < minHumanTwinHealth) {
        minHumanTwinHealth = operatorB.humanTwinHealthScore;
    }
}

if (operatorC != null) {
    healthTotal += operatorC.humanTwinHealthScore;
    healthOperators++;

    if (operatorC.humanTwinHealthScore < minHumanTwinHealth) {
        minHumanTwinHealth = operatorC.humanTwinHealthScore;
    }
}

double currentAverageHumanTwinHealth = 100.0;

if (healthOperators > 0) {
    currentAverageHumanTwinHealth = healthTotal / healthOperators;
}

humanTwinHealthSum += currentAverageHumanTwinHealth;
humanTwinHealthSamples++;

if (humanTwinHealthSamples > 0) {
    averageHumanTwinHealth = humanTwinHealthSum / humanTwinHealthSamples;
}

if (currentAverageHumanTwinHealth < 40.0) {
    lowHumanTwinHealthTime += 1.0;
}]]></Action>
				</Event>
				<Event>
					<Id>1777467040952</Id>
					<Name><![CDATA[endShiftEvent]]></Name>
					<X>200</X><Y>1012</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1777467040950</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777536000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[getSimulationDurationMinutes()]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[double shiftDurationMinutes = getSimulationDurationMinutes();
double shiftDurationHours = shiftDurationMinutes / 60.0;

// =========================
// THROUGHPUT
// =========================

double throughput = 0.0;
double throughputA = 0.0;
double throughputB = 0.0;
double throughputC = 0.0;

if (shiftDurationHours > 0) {
    throughput = completedJobs / shiftDurationHours;
    throughputA = completedJobsA / shiftDurationHours;
    throughputB = completedJobsB / shiftDurationHours;
    throughputC = completedJobsC / shiftDurationHours;
}

// =========================
// FATIGUE KPIs
// =========================

double highFatiguePercentage = 0.0;

if (shiftDurationMinutes > 0) {
    highFatiguePercentage = (highFatigueTime / shiftDurationMinutes) * 100.0;
}

double finalFatigue = 0.0;

if (currentOperator != null) {
    finalFatigue = currentOperator.fatigue;
}

double finalFatigueA = 0.0;
double finalFatigueB = 0.0;
double finalFatigueC = 0.0;

if (operatorA != null) {
    finalFatigueA = operatorA.fatigue;
}

if (operatorB != null) {
    finalFatigueB = operatorB.fatigue;
}

if (operatorC != null) {
    finalFatigueC = operatorC.fatigue;
}

// =========================
// RECOVERY KPIs
// =========================

double averageRecoveryDuration = 0.0;

if (numberOfRecoveries > 0) {
    averageRecoveryDuration = totalRecoveryTime / numberOfRecoveries;
}

if (totalRecoveryTime > 0) {
    recoveryEfficiency = totalFatigueReduction / totalRecoveryTime;
} 
else {
    recoveryEfficiency = 0.0;
}

// =========================
// MODE NAME
// =========================

String modeName = "";

if (experimentMode == 1) {
    if (baselinePolicyType == 1) {
        modeName = "No-recovery baseline";
    }
    else if (baselinePolicyType == 2) {
        modeName = "Threshold-recovery baseline";
    }
    else if (baselinePolicyType == 3) {
        modeName = "GA work-60 recovery-40 baseline";
    }
    else {
        modeName = "Unknown baseline";
    }
}
else if (experimentMode == 2) {
    modeName = "Exploration mode";
} 
else if (experimentMode == 3) {
    modeName = "RL agent mode";
} 
else {
    modeName = "Unknown mode";
}

// =========================
// REPORT
// =========================

traceln(" ");
traceln("========== SHIFT RESULTS ==========");
traceln("Mode: " + modeName);

traceln("--- Productivity ---");
traceln("Shift duration: " + roundToDecimal(shiftDurationHours, 2) + " hours");
traceln("Shift duration: " + roundToDecimal(shiftDurationMinutes, 2) + " min");

traceln("Completed jobs A: " + completedJobsA);
traceln("Completed jobs B: " + completedJobsB);
traceln("Completed jobs C: " + completedJobsC);
traceln("Completed jobs total: " + completedJobs);

traceln("Throughput A: " + roundToDecimal(throughputA, 2) + " jobs/hour");
traceln("Throughput B: " + roundToDecimal(throughputB, 2) + " jobs/hour");
traceln("Throughput C: " + roundToDecimal(throughputC, 2) + " jobs/hour");
traceln("Throughput total: " + roundToDecimal(throughput, 2) + " jobs/hour");

traceln("Average job time: " + roundToDecimal(averageJobTime, 2) + " min");
traceln("Average queue length: " + roundToDecimal(averageQueueLength, 2));
traceln("Max queue length: " + maxQueueLength);

traceln(" ");

traceln("--- Fatigue ---");
traceln("Average fatigue: " + roundToDecimal(averageFatigue, 3));
traceln("Final fatigue last active operator: " + roundToDecimal(finalFatigue, 3));
traceln("Final fatigue Operator A: " + roundToDecimal(finalFatigueA, 3));
traceln("Final fatigue Operator B: " + roundToDecimal(finalFatigueB, 3));
traceln("Final fatigue Operator C: " + roundToDecimal(finalFatigueC, 3));
traceln("Max fatigue: " + roundToDecimal(maxFatigue, 3));
traceln("Time above Hy: " + roundToDecimal(highFatigueTime, 2) + " min");
traceln("Time above Hy (percent): " + roundToDecimal(highFatiguePercentage, 2));

traceln(" ");

traceln("--- Recovery ---");
traceln("Number of recoveries: " + numberOfRecoveries);
traceln("Adaptive recoveries: " + numberAdaptiveRecoveries);
traceln("Long recoveries: " + numberLongRecoveries);
traceln("Total recovery time: " + roundToDecimal(totalRecoveryTime, 2) + " min");
traceln("Average recovery duration: " + roundToDecimal(averageRecoveryDuration, 2) + " min");
traceln("Recovery efficiency: " + roundToDecimal(recoveryEfficiency, 4) + " fatigue/min");

traceln("===================================");

// This event only reports shift KPIs. It must never stop a fixed schedule.
// The simulation is terminated by finishIfFixedScheduleCompleted().
exportRlEventLog();
exportRlDecisionLog();]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
