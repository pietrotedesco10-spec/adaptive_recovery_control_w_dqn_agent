							<Name><![CDATA[seizeBlocks]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[movingGoHome]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[wrapUpTaskPolicyType]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[wrapUpTaskPriority]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[wrapUpTaskMayPreemptOtherTasks]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[wrapUpTaskPreemptionPolicy]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[wrapUpUsageState]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onReleaseUnit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Job job = (Job) agent;

Operator op = job.assignedOperator;

if (op == null) {
    return;
}

op.isWorking = false;
op.idleTime = 0;

double jobDuration = time() - job.jobStartTime;
boolean validScheduledActivity =
    job.jobTypeBase != null &&
    job.jobTypeBase.length() > 0 &&
    !job.jobTypeBase.startsWith("null") &&
    !"invalid".equals(job.jobTypeBase);
boolean productiveJob =
    validScheduledActivity && !"idle".equals(job.jobTypeBase);

op.updateShiftTracking();

double normalizedProcessingEffort = 0.0;

if (productiveJob && job.nominalProcessingTime > 0) {
    normalizedProcessingEffort =
        jobDuration / job.nominalProcessingTime;
}

if (productiveJob) {
    op.lastJobHadBreak = op.hadBreakSinceLastJob;
    op.tdNormCumsumCurrentShift += normalizedProcessingEffort;
}

if (productiveJob) {
    completedJobsA++;
    completedJobs++;
    totalJobTime += jobDuration;
}

if (completedJobs > 0) {
    averageJobTime = totalJobTime / completedJobs;
}

lastServiceTime = jobDuration;

currentOperator = op;

addLogRow(
    "OperatorA",
    job.jobType,
    "end",
    jobDuration,
    op.fatigue,
    lastServiceTime,
    job.nominalProcessingTime,
    "idle".equals(job.jobTypeBase) ? "Idle" : (op.onBreak ? "Break" : "Working")
);

if (productiveJob && job.jobTypeBase != null) {
    completedScheduledActivities.add(job.jobTypeBase);
}

if (validScheduledActivity && registerFixedScheduleCompletion(op.stationName)) {
    return;
}
makeRecoveryDecision(op);
dispatchReadyScheduledTasks();]]></Code>
