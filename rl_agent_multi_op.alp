						<Parameter>
							<Name><![CDATA[onSeizeUnit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Job job = (Job) agent;

job.assignedOperator = (Operator) unit;
scheduledDispatchInFlight.remove("OperatorA");
job.assignedOperator.configureOperator("A");
job.assignedOperator.lambda = job.taskLambda;

job.assignedOperator.isWorking = !"idle".equals(job.jobTypeBase);
job.assignedOperator.idleTime = 0;
job.assignedOperator.breakTime = 0;

job.jobStartTime = time();
job.stationName = "Station A";

job.assignedOperator.stationName = "A";

operatorA = job.assignedOperator;
currentOperator = job.assignedOperator;

// Final job type for station A
job.jobType = job.jobTypeBase + "_A";

addLogRow(
    "OperatorA",
    job.jobType,
    "start",
    0.0,
    job.assignedOperator.fatigue,
    0.0,
    job.nominalProcessingTime,
    "idle".equals(job.jobTypeBase) ? "Idle" : ("idle".equals(job.jobTypeBase) ? "Idle" : (job.assignedOperator.onBreak ? "Break" : "Working"))
);]]></Code>
							</Value>
