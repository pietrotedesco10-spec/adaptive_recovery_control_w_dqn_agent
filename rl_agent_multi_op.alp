				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783000020003</Id>
					<Name><![CDATA[initializeScheduledJob]]></Name>
					<X>860</X><Y>977</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[job]]></Name>
						<Type><![CDATA[Job]]></Type>
					</Parameter>
					<Body><![CDATA[if (job == null) {
    return;
}

if (fixedTaskSchedule.isEmpty()) {
    loadFixedTaskSchedule();
}

if (fixedTaskSchedule.isEmpty()) {
    return;
}

    String operatorName = scheduledDispatchOperatorName;

    if (!scheduledDispatchQueue.isEmpty()) {
        operatorName = scheduledDispatchQueue.remove(0);
    }

    if (operatorName == null || operatorName.length() == 0) {
        operatorName = "OperatorA";
    }

    int expectedForOperator = 0;
    for (String[] scheduledRow : fixedTaskSchedule) {
        if (operatorName.equals(scheduledRow[0])) {
            expectedForOperator++;
        }
    }

    int completedForOperator =
        fixedTaskScheduleCompletedByOperator.containsKey(operatorName)
        ? fixedTaskScheduleCompletedByOperator.get(operatorName) : 0;

    if (completedForOperator >= expectedForOperator) {
        return;
    }

    int startIndex = fixedTaskScheduleIndexByOperator.containsKey(operatorName)
        ? fixedTaskScheduleIndexByOperator.get(operatorName)
        : 0;

    String[] row = null;
    int nextIndex = startIndex;

    for (int candidateIndex = startIndex;
         candidateIndex < fixedTaskSchedule.size();
         candidateIndex++) {
        String[] candidate = fixedTaskSchedule.get(candidateIndex);

        if (operatorName.equals(candidate[0])) {
            row = candidate;
            nextIndex = candidateIndex + 1;
            break;
        }
    }

    if (row == null) {
        return;
    }

    fixedTaskScheduleIndexByOperator.put(operatorName, nextIndex);

    String taskType = row[1];

    job.taskType = taskType;
    // Keep the complete schedule identifier, for example job_1_task_1.
    job.jobTypeBase = taskType;
    double scheduledProcessingTime = Double.parseDouble(row[2]);

    if ("idle".equals(taskType)) {
        // A delay can consume part or all of the idle already planned in the schedule.
        double plannedEndMinutes = row.length > 5
            ? Double.parseDouble(row[5])
            : Double.parseDouble(row[4]) + scheduledProcessingTime;
        job.nominalProcessingTime = Math.max(
            0.001,
            activeScheduleStartTime + plannedEndMinutes - time()
        );
    }
    else {
        // Keep stochastic processing times for productive tasks.
        job.nominalProcessingTime = Math.max(
            0.01,
            normal(taskProcessingTimeSigma, scheduledProcessingTime)
        );
    }
    job.taskLambda = Double.parseDouble(row[3]);

    if ("OperatorA".equals(operatorName)) {
        job.selectedStation = 1;
    }
    else if ("OperatorB".equals(operatorName)) {
        job.selectedStation = 2;
    }
    else if ("OperatorC".equals(operatorName)) {
        job.selectedStation = 3;
    }
    else {
        throw new IllegalArgumentException(
            "Unsupported operator in schedule: " + operatorName
        );
    }

    if (!initialScheduledDispatchDone && scheduledDispatchOperatorName.length() == 0) {
        initialScheduledDispatchDone = true;
        dispatchNextScheduledTaskForOperator("B");
        dispatchNextScheduledTaskForOperator("C");
    }
if (job.selectedStation == 1) {
    job.stationName = "Station A";
}
else if (job.selectedStation == 2) {
    job.stationName = "Station B";
}
else if (job.selectedStation == 3) {
    job.stationName = "Station C";
}
else {
    throw new IllegalStateException(
        "Scheduled task has no valid A/B/C station."
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783000020012</Id>
					<Name><![CDATA[dispatchNextScheduledTaskForOperator]]></Name>
					<X>1200</X><Y>1012</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[stationName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!useFixedTaskSchedule) {
    return;
}

String operatorName = "";
Operator op = null;
int station = 0;

if ("A".equals(stationName) || "OperatorA".equals(stationName)) {
    operatorName = "OperatorA";
    op = operatorA;
    station = 1;
}
else if ("B".equals(stationName) || "OperatorB".equals(stationName)) {
    operatorName = "OperatorB";
    op = operatorB;
    station = 2;
}
else if ("C".equals(stationName) || "OperatorC".equals(stationName)) {
    operatorName = "OperatorC";
    op = operatorC;
    station = 3;
}
else {
    return;
}

if (op != null && (op.isWorking || op.onBreak || op.recoveryRequested)) {
    return;
}

// Do not inject another entity while this operator already has one
// travelling between Source and Seize.
if (
    scheduledDispatchQueue.contains(operatorName) ||
    scheduledDispatchInFlight.contains(operatorName)
) {
    return;
}

if (fixedTaskSchedule.isEmpty()) {
    loadFixedTaskSchedule();
}

int expectedForOperator = 0;
for (String[] scheduledRow : fixedTaskSchedule) {
    if (operatorName.equals(scheduledRow[0])) {
        expectedForOperator++;
    }
}

int completedForOperator = fixedTaskScheduleCompletedByOperator.containsKey(operatorName)
    ? fixedTaskScheduleCompletedByOperator.get(operatorName) : 0;

// Do not inject an empty Job after this operator has finished its schedule.
if (completedForOperator >= expectedForOperator) {
    return;
}

if (
    (station == 1 && queueA.size() > 0) ||
    (station == 2 && queueB.size() > 0) ||
    (station == 3 && queueC.size() > 0)
) {
    return;
}

String[] nextRow = peekNextScheduledRowForOperator(operatorName);

if (nextRow == null || nextRow.length < 2) {
    return;
}

if (!isScheduledTaskReady(nextRow[1])) {
    if (!precedenceWaitStartByOperator.containsKey(operatorName)) {
        precedenceWaitStartByOperator.put(operatorName, time());
        addLogRow(
            operatorName,
            "idle_precedence_" + stationName,
            "start",
            0.0,
            op != null ? op.fatigue : 0.0,
            0.0,
            0.0,
            "Idle"
        );
    }
    return;
}

if (precedenceWaitStartByOperator.containsKey(operatorName)) {
    double waitStart = precedenceWaitStartByOperator.remove(operatorName);
    double waitDuration = Math.max(0.0, time() - waitStart);
    addLogRow(
        operatorName,
        "idle_precedence_" + stationName,
        "end",
        waitDuration,
        op != null ? op.fatigue : 0.0,
        0.0,
        0.0,
        "Idle"
    );
}

scheduledDispatchQueue.add(operatorName);
scheduledDispatchInFlight.add(operatorName);
source.inject(1);
scheduledDispatchOperatorName = "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783000020101</Id>
					<Name><![CDATA[getScheduledTaskPredecessor]]></Name>
					<X>1200</X><Y>1047</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[activityId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (activityId == null || "idle".equals(activityId)) {
    return "";
}

int markerIndex = activityId.lastIndexOf("_task_");

if (markerIndex < 0) {
    return "";
}

String taskNumberText = activityId.substring(markerIndex + 6);

try {
    int taskNumber = Integer.parseInt(taskNumberText);

    if (taskNumber <= 1) {
        return "";
    }

    return activityId.substring(0, markerIndex + 6) + (taskNumber - 1);
}
catch (NumberFormatException ex) {
    return "";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1783000020102</Id>
					<Name><![CDATA[isScheduledTaskReady]]></Name>
					<X>1200</X><Y>1082</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[activityId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (activityId == null || activityId.length() == 0) {
    return false;
}

if ("idle".equals(activityId)) {
    return true;
}

String predecessor = getScheduledTaskPredecessor(activityId);
return predecessor.length() == 0 || completedScheduledActivities.contains(predecessor);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783000020103</Id>
					<Name><![CDATA[dispatchReadyScheduledTasks]]></Name>
					<X>1200</X><Y>1117</Y>
					<Label><X>10</X><Y>0</Y></Label>
