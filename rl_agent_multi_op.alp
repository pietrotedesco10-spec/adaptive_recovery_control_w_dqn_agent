					<Body><![CDATA[try {
    // Use simulationSeed for reproducible, matched filenames across scenarios.
    // Change simulationSeed in the model UI to run a new batch.
    String _seedSuffix = "_s" + simulationSeed;
    String _evtBase   = outputLogName.replace(".csv", "");
    String filePath   = "C:/Users/pietr/Desktop/fatigue_rl_agent/data/anylogic_logs/" + _evtBase + _seedSuffix + ".csv";

    java.io.PrintWriter writer = new java.io.PrintWriter(filePath, "UTF-8");
    writer.print(rlEventLog);
    writer.close();

    traceln("RL event log exported to: " + filePath);

} catch (Exception e) {
    traceln("Error exporting RL event log: " + e);
}]]></Body>
				</Function>
