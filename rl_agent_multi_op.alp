				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1783000020099</Id>
					<Name><![CDATA[finishIfFixedScheduleCompleted]]></Name>
					<X>860</X><Y>1012</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!useFixedTaskSchedule || fixedTaskSchedule.isEmpty()) {
    return false;
}

int expectedA = 0;
int expectedB = 0;
int expectedC = 0;

for (String[] row : fixedTaskSchedule) {
    if ("OperatorA".equals(row[0])) expectedA++;
    else if ("OperatorB".equals(row[0])) expectedB++;
    else if ("OperatorC".equals(row[0])) expectedC++;
}

int completedA = fixedTaskScheduleCompletedByOperator.containsKey("OperatorA")
    ? fixedTaskScheduleCompletedByOperator.get("OperatorA") : 0;
int completedB = fixedTaskScheduleCompletedByOperator.containsKey("OperatorB")
    ? fixedTaskScheduleCompletedByOperator.get("OperatorB") : 0;
int completedC = fixedTaskScheduleCompletedByOperator.containsKey("OperatorC")
    ? fixedTaskScheduleCompletedByOperator.get("OperatorC") : 0;

boolean completed =
    completedA >= expectedA &&
    completedB >= expectedB &&
    completedC >= expectedC;

if (completed) {
    if (startNextExplorationSchedule()) {
        return true;
    }

    traceln("ALL EXPLORATION SCHEDULES COMPLETED.");
    exportRlEventLog();
    exportRlDecisionLog();

    try {
        String markerBase = outputLogName.replace(".csv", "");
        String markerPath =
            "C:/Users/pietr/Desktop/fatigue_rl_agent/data/anylogic_logs/" +
            markerBase + "_s" + simulationSeed + ".done";
        java.io.PrintWriter markerWriter =
            new java.io.PrintWriter(markerPath, "UTF-8");
        markerWriter.println("complete");
        markerWriter.close();
    }
    catch (Exception e) {
        traceln("Error exporting completion marker: " + e);
    }

    finishSimulation();
    return true;
}

return false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1783000020100</Id>
					<Name><![CDATA[registerFixedScheduleCompletion]]></Name>
					<X>860</X><Y>1047</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[operatorName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!useFixedTaskSchedule || operatorName == null) {
    return false;
}

String normalizedOperatorName = operatorName;
if ("A".equals(operatorName)) normalizedOperatorName = "OperatorA";
else if ("B".equals(operatorName)) normalizedOperatorName = "OperatorB";
else if ("C".equals(operatorName)) normalizedOperatorName = "OperatorC";

int completed = fixedTaskScheduleCompletedByOperator.containsKey(normalizedOperatorName)
    ? fixedTaskScheduleCompletedByOperator.get(normalizedOperatorName) : 0;

fixedTaskScheduleCompletedByOperator.put(normalizedOperatorName, completed + 1);
return finishIfFixedScheduleCompleted();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777451110186</Id>
					<Name><![CDATA[getServiceTime]]></Name>
					<X>1200</X><Y>1152</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[job]]></Name>
						<Type><![CDATA[Job]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null || job == null) {
    return 10.0;
}

if ("idle".equals(job.jobTypeBase)) {
    lastServiceTime = job.nominalProcessingTime;
    return job.nominalProcessingTime;
}

double baseTime = job.nominalProcessingTime;

// Götz fatigue coefficient: no slowdown up to 0.25 fatigue.
double fatigueCoefficient = op.fatigue <= 0.25
    ? 1.0
    : 0.75 + op.fatigue;

double serviceTime = baseTime * fatigueCoefficient;

lastServiceTime = serviceTime;

return serviceTime;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1777463562762</Id>
					<Name><![CDATA[addLogRow]]></Name>
					<X>1200</X><Y>1752</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[operatorName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[jobType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[event]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[duration]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fatigueValue]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[processingTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nominalProcessingTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[operatorState]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int totalSeconds = (int)(time() * 60);

int hours = totalSeconds / 3600;
int minutes = (totalSeconds % 3600) / 60;
int seconds = totalSeconds % 60;

String simTime = String.format(
    "%02d:%02d:%02d",
    hours,
    minutes,
    seconds
);

int durationSeconds = (int)(duration * 60);

int durationMinutes = durationSeconds / 60;
int durationSec = durationSeconds % 60;

String durationFormatted = String.format(
    "%02d:%02d",
    durationMinutes,
    durationSec
);

int processingSeconds = (int)(processingTime * 60);

int processingMinutes = processingSeconds / 60;
int processingSec = processingSeconds % 60;

String processingFormatted = String.format(
    "%02d:%02d",
    processingMinutes,
    processingSec
);

int totalQueueLength = queueA.size() + queueB.size() + queueC.size();

String row = String.format(
    "%-10s | %-10s | %-20s | %-8s | %-10s | %-8.3f | queue=%-6d | completed=%-5d | %-15s | %-15s",
    simTime,
    operatorName,
    jobType,
    event,
    durationFormatted,
    fatigueValue,
    totalQueueLength,
    completedJobs,
    processingFormatted,
    operatorState
);

eventLog += row + "\n";

traceln(row);

// CSV log for Python / analysis.
String rlRow = String.format(
    java.util.Locale.US,
    "%.4f,%s,%s,%s,%.4f,%.6f,%d,%d,%.4f,%.4f,%s",
    time(),
    operatorName,
    jobType,
    event,
    duration,
    fatigueValue,
    totalQueueLength,
    completedJobs,
    processingTime,
    nominalProcessingTime,
    operatorState
);

rlEventLog += rlRow + "\n";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
