		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1777387290514</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[// Read optional values supplied by run_experiment_batch.py.
String automatedMode = System.getenv("FATIGUE_RL_MODE");
String automatedBaseline = System.getenv("FATIGUE_RL_BASELINE");
String automatedSeed = System.getenv("FATIGUE_RL_SEED");
boolean automatedRun =
    "1".equals(System.getenv("FATIGUE_RL_AUTOMATED"));

if (automatedMode != null && automatedMode.length() > 0) {
    experimentMode = Integer.parseInt(automatedMode);
}
if (automatedBaseline != null && automatedBaseline.length() > 0) {
    baselinePolicyType = Integer.parseInt(automatedBaseline);
}
if (automatedSeed != null && automatedSeed.length() > 0) {
    simulationSeed = Integer.parseInt(automatedSeed);
}
if (automatedRun) {
    getEngine().setRealTimeMode(false);
}

// Seed the RNG with simulationSeed so every scenario in the same batch
// (same simulationSeed value) has identical stochastic conditions.
// Change simulationSeed = 1, 2, 3 ... before each new batch of runs.
getDefaultRandomGenerator().setSeed(simulationSeed);

String eventHeader = String.format(
    "%-10s | %-10s | %-20s | %-8s | %-10s | %-8s | %-12s | %-14s | %-15s | %-15s",
    "time",
    "operator",
    "job_id",
    "event",
    "duration",
    "fatigue",
    "queue length",
    "completed jobs",
    "processing time",
    "operator state"
);

// Human-readable event log shown in AnyLogic.
// It must be reset together with the CSV log at every simulation run.
eventLog = eventHeader + "\n";

traceln(eventHeader);

// RL decision log header.
rlDecisionLog =
    "decisionTime,operator,station,operatorType,mode,region,selectedAction,actionType,recordType," +
    "numberLongRecoveries,numberAdaptiveRecoveries,timeSinceLastRecovery," +
    "currentFatigue,distanceFromHx,distanceFromHy,timeToReachHy," +
    "queueLength,completedJobs,completedJobsA,completedJobsB,completedJobsC,lastServiceTime," +
    "operatorAOnBreak,operatorBOnBreak,operatorCOnBreak,otherOperatorOnBreak,numberOperatorsOnBreak," +
    "workTime,tdNormCumsumCurrentShift,lastJobHadBreak," +
"fatigueA,fatigueB,fatigueC,numberOperatorsWorking," +
"globalAverageFatigue,globalMaxFatigue,globalMinFatigue,fatigueImbalance," +
"nextTaskType,nextTaskDuration,predictedFatigueAfterNextTask," +
    "secondTaskType,predictedFatigueAfterTwoTasks," +
    "timeToNextIdle,nextIdleDuration,remainingScheduledDuration," +
    "secondTaskDuration,nextTaskReady,scheduleId\n";

// Physical event log header.
rlEventLog =
    "timestamp,operator,job_id,event,duration,fatigue,queueLength,completedJobs,processingTime,nominalProcessingTime,operatorState\n";
// Output file name by scenario.
if (experimentMode == 1 && baselinePolicyType == 1) {
    outputLogName = "rl_event_log_no_recovery.csv";
}
else if (experimentMode == 1 && baselinePolicyType == 2) {
    outputLogName = "rl_event_log_threshold_recovery.csv";
}
else if (experimentMode == 1 && baselinePolicyType == 3) {
    outputLogName = "rl_event_log_work60_recovery40.csv";
}
else if (experimentMode == 2) {
    outputLogName = "rl_event_log_exploration.csv";
}
else if (experimentMode == 3) {
    outputLogName = "rl_event_log_dqn_adaptive_recovery.csv";
}
else {
    outputLogName = "rl_event_log.csv";
}

// The fixed schedule is the only source of production activities.
useFixedTaskSchedule = true;
loadFixedTaskSchedule();
initialScheduledDispatchDone = true;
dispatchNextScheduledTaskForOperator("A");
dispatchNextScheduledTaskForOperator("B");
dispatchNextScheduledTaskForOperator("C");]]></StartupCode>
