				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785000030001</Id>
					<Name><![CDATA[getProjectedFatigueAfterNextTask]]></Name>
					<X>500</X><Y>1927</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[startingFatigue]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return 0.0;
}

double f = Math.max(0.0, Math.min(0.999999, startingFatigue));
double durationMinutes = getNextTaskDuration(op);
double lambda = getNextTaskLambda(op);

// Use a one-sigma duration forecast for productive tasks. The DQN therefore
// learns stochastic risk directly, without a deployment-time safety override.
if (getNextTaskTypeCode(op) != 0.0 && lambda > 0.0) {
    durationMinutes += taskProcessingTimeSigma;
}

double durationSeconds = durationMinutes * 60.0;

if (durationSeconds <= 0.0) {
    return f;
}

// Idle time follows the same exponential recovery used by Operator.updateFatigue().
if (getNextTaskTypeCode(op) == 0.0 || lambda <= 0.0) {
    return Math.max(0.0, Math.min(1.0, f * Math.exp(-op.mu * durationSeconds)));
}

// Match getServiceTime(): fatigue above 0.25 lengthens the actual task.
double fatigueCoefficient = f <= 0.25 ? 1.0 : 0.75 + f;
double effectiveDurationSeconds = durationSeconds * fatigueCoefficient;

double shiftProgress = 0.0;

if (standardShiftHours > 0.0) {
    shiftProgress = getElapsedShiftHours() / standardShiftHours;
}

shiftProgress = Math.max(0.0, Math.min(1.0, shiftProgress));

double shiftTimeMultiplier = 1.0 + 0.05 * shiftProgress;
double effectiveLambda =
    lambda *
    op.fatigueRateMultiplier *
    shiftTimeMultiplier;

double predictedFatigue =
    f + (1.0 - f) * (1.0 - Math.exp(-effectiveLambda * effectiveDurationSeconds));

return Math.max(0.0, Math.min(1.0, predictedFatigue));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
