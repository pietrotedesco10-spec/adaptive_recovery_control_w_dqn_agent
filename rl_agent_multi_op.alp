			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1777388250796</Id>
					<Name><![CDATA[Working]]></Name>
					<X>440</X><Y>130</Y>
					<Label><X>20</X><Y>14</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="40">
						<EntryAction><![CDATA[onBreak = false;
breakTime = 0;
recoveryRequested = false;
selectedAction = 0;
recoveryDuration = 0;
recoveryType = "none";

// At model startup, stationName may still be UNASSIGNED.
// In that case, do not touch any production line.
if ("A".equals(stationName)) {
    main.OperatorPoolA.set_capacity(1);
    main.holdA.unblock();
}
else if ("B".equals(stationName)) {
    main.OperatorPoolB.set_capacity(1);
    main.holdB.unblock();
}]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1777388253816</Id>
					<Name><![CDATA[Recovery]]></Name>
					<X>440</X><Y>250</Y>
					<Label><X>20</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="40">
						<EntryAction><![CDATA[onBreak = true;
workTime = 0;
breakTime = 0;

recoveryStartTime = time();

if ("A".equals(stationName)) {
    main.holdA.block();
    main.OperatorPoolA.set_capacity(0);
}
else if ("B".equals(stationName)) {
    main.holdB.block();
    main.OperatorPoolB.set_capacity(0);
}
else if ("C".equals(stationName)) {
    main.holdC.block();
    main.OperatorPoolC.set_capacity(0);
}
else {
    traceln("WARNING: Recovery entered with stationName not assigned.");
}

if (selectedAction == 1) {
    main.numberAdaptiveRecoveries++;
}

if (selectedAction == 2) {
    main.numberLongRecoveries++;
}

main.numberOfRecoveries++;
main.lastRecoveryStartTime = time();
main.fatigueBeforeRecovery = fatigue;

String operatorName = "";

if ("A".equals(stationName)) {
    operatorName = "OperatorA";
}
else if ("B".equals(stationName)) {
    operatorName = "OperatorB";
}
else if ("C".equals(stationName)) {
    operatorName = "OperatorC";
}
else {
    operatorName = "OperatorUnknown";
}

String recoveryJobType = "recovery_" + stationName;

main.addLogRow(
    operatorName,
    recoveryJobType,
    "start",
    recoveryDuration,
    fatigue,
    0.0,
    0.0,
    recoveryType
);]]></EntryAction>
						<ExitAction><![CDATA[double actualRecoveryDuration = time() - recoveryStartTime;

main.totalRecoveryTime += actualRecoveryDuration;
lastRecoveryTime = time();

double fatigueReduction = main.fatigueBeforeRecovery - fatigue;

if (fatigueReduction > 0) {
    main.totalFatigueReduction += fatigueReduction;
}

String operatorName = "";

if ("A".equals(stationName)) {
    operatorName = "OperatorA";
}
else if ("B".equals(stationName)) {
    operatorName = "OperatorB";
}
else if ("C".equals(stationName)) {
    operatorName = "OperatorC";
}
else {
    operatorName = "OperatorUnknown";
}

String recoveryJobType = "recovery_" + stationName;

updateShiftTracking();
hadBreakSinceLastJob = 1;
lastJobHadBreak = 1;
tdNormCumsumCurrentShift = 0.0;

main.addLogRow(
    operatorName,
    recoveryJobType,
    "end",
    actualRecoveryDuration,
    fatigue,
    0.0,
    0.0,
    recoveryType
);

// Operator becomes available again
if ("A".equals(stationName)) {
    main.OperatorPoolA.set_capacity(1);
    main.holdA.unblock();
}
else if ("B".equals(stationName)) {
    main.OperatorPoolB.set_capacity(1);
    main.holdB.unblock();
}
else if ("C".equals(stationName)) {
    main.OperatorPoolC.set_capacity(1);
    main.holdC.unblock();
}
onBreak = false;
recoveryRequested = false;
selectedAction = 0;
recoveryDuration = 0;
recoveryType = "none";

// Record the state immediately after recovery.
main.currentOperator = this;
main.addDecisionLogRow(
    main.getFatigueRegion(fatigue),
    0,
    "recovery_end"
);

main.dispatchReadyScheduledTasks();]]></ExitAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
