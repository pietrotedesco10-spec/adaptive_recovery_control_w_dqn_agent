					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[return op == null ? 0.0 : getProjectedFatigueAfterNextTask(op, op.fatigue);]]></Body>
				</Function>
