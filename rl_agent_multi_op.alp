					<Name><![CDATA[getNextScheduledIdleDuration]]></Name>
					<X>500</X><Y>1717</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return 0.0;
}

String operatorName = getOperatorFullName(op);
int startIndex = fixedTaskScheduleIndexByOperator.containsKey(operatorName)
    ? fixedTaskScheduleIndexByOperator.get(operatorName)
    : 0;

for (int index = startIndex; index < fixedTaskSchedule.size(); index++) {
    String[] row = fixedTaskSchedule.get(index);

    if (operatorName.equals(row[0]) && "idle".equals(row[1])) {
        return Math.max(0.0, Double.parseDouble(row[2]));
    }
}

return 0.0;]]></Body>
