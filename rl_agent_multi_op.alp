			<Events>
				<Event>
					<Id>1777388404912</Id>
					<Name><![CDATA[fatigueUpdate]]></Name>
					<X>40</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1777388404910</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1777449600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[updateShiftTracking();
updateFatigue(1.0);

// Baseline decisions are evaluated only after a task is completed.
// This event updates fatigue while the task is running but never interrupts it.
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1777388041662</Id>
					<Name><![CDATA[updateFatigue]]></Name>
					<X>40</X><Y>448</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dtSeconds]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[updateShiftTracking();

double dt = Math.max(0.0, dtSeconds);
double dtMinutes = dt / 60.0;

if (dt <= 0) {
    updateHumanTwinState();
    return;
}

if (onBreak) {

    // Glock recovery model: R(t) = F * exp(-mu * t).
    breakTime += dtMinutes;
    idleTime = 0.0;
    workTime = 0.0;

    fatigue = fatigue * Math.exp(-mu * dt);
}
else if (isWorking) {

    // Glock fatigue model with progressive shift sensitivity.
    workTime += dtMinutes;
    breakTime = 0.0;
    idleTime = 0.0;

    double shiftProgress = 0.0;

    if (main.standardShiftHours > 0.0) {
        shiftProgress = main.getElapsedShiftHours() / main.standardShiftHours;
    }

    shiftProgress = Math.max(0.0, Math.min(1.0, shiftProgress));

    double shiftTimeMultiplier = 1.0 + 0.05 * shiftProgress;
    double effectiveLambda =
        lambda *
        fatigueRateMultiplier *
        shiftTimeMultiplier;

    fatigue = fatigue + (1.0 - fatigue) * (1.0 - Math.exp(-effectiveLambda * dt));
}
else {

    // Idle time is treated as rest and follows the same Glock recovery law.
    idleTime += dtMinutes;
    breakTime += dtMinutes;
    workTime = 0.0;

    fatigue = fatigue * Math.exp(-mu * dt);
}

updateHumanTwinState();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778072081764</Id>
					<Name><![CDATA[requestRecovery]]></Name>
					<X>240</X><Y>322</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[traceln("requestRecovery called at time: " + time() + " with action: " + action);

if (onBreak) {
    traceln("Operator already in recovery. Request ignored.");
    return;
}

selectedAction = action;

double recoveryMu = Math.max(mu, 0.000001);
double shortResidualFatigue = 0.60;  // 40% fatigue reduction
double longResidualFatigue = 0.40;   // 60% fatigue reduction

if (action == 0) {
    recoveryRequested = false;
    recoveryDuration = 0;
    recoveryType = "none";

    if ("A".equals(stationName)) {
        main.holdA.unblock();
        main.OperatorPoolA.set_capacity(1);
    }
    else if ("B".equals(stationName)) {
        main.holdB.unblock();
        main.OperatorPoolB.set_capacity(1);
    }
    else if ("C".equals(stationName)) {
        main.holdC.unblock();
        main.OperatorPoolC.set_capacity(1);
    }
    return;
}

if (action == 1) {
    recoveryDuration = -Math.log(shortResidualFatigue) / recoveryMu / 60.0;
    recoveryType = "short_break";
}
else if (action == 2) {
    // The GA baselines use action 2 as the same long recovery in every policy.
    // Only the number of recovery points differs between the GA ratios.
    recoveryDuration = -Math.log(longResidualFatigue) / recoveryMu / 60.0;
    recoveryType = "long_break";
}
else {
    recoveryDuration = 0;
    recoveryType = "none";
    recoveryRequested = false;

    if ("A".equals(stationName)) {
        main.holdA.unblock();
        main.OperatorPoolA.set_capacity(1);
    }
    else if ("B".equals(stationName)) {
        main.holdB.unblock();
        main.OperatorPoolB.set_capacity(1);
    }
    else if ("C".equals(stationName)) {
        main.holdC.unblock();
        main.OperatorPoolC.set_capacity(1);
    }
    return;
}

if ("A".equals(stationName)) {
    main.holdA.block();
    main.OperatorPoolA.set_capacity(0);
}
else if ("B".equals(stationName)) {
    main.holdB.block();
    main.OperatorPoolB.set_capacity(0);
}
else if ("C".equals(stationName)) {
    main.holdC.block();
    main.OperatorPoolC.set_capacity(0);
}
else {
    traceln("WARNING: requestRecovery called but stationName is not assigned.");
    return;
}

recoveryRequested = true;

traceln(
    "Recovery requested: " + recoveryType +
    " | duration: " + recoveryDuration +
    " | station: " + stationName
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779092698547</Id>
					<Name><![CDATA[configureOperator]]></Name>
					<X>600</X><Y>364</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[profile]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if ("A".equals(profile)) {

    operatorProfile = "OperatorA_simple_specialist";

    // Simple-task specialist with lower fatigue growth.
    fastSkillMultiplier = 1.00;
    slowSkillMultiplier = 1.00;

    fatigueRateMultiplier = 0.95;

    fatigueSpeedImpact = 0.40;
}
else if ("B".equals(profile)) {

    operatorProfile = "OperatorB_complex_specialist";

    // Complex-task specialist with higher fatigue growth.
    fastSkillMultiplier = 1.00;
    slowSkillMultiplier = 1.00;

    fatigueRateMultiplier = 1.05;

    fatigueSpeedImpact = 0.60;
}
else if ("C".equals(profile)) {

    operatorProfile = "OperatorC_balanced_resilient";

    // Balanced operator with lower fatigue sensitivity.
    fastSkillMultiplier = 1.00;
    slowSkillMultiplier = 1.00;

    fatigueRateMultiplier = 0.98;

    fatigueSpeedImpact = 0.45;
}
else {

    operatorProfile = "generic";

    fastSkillMultiplier = 1.0;
    slowSkillMultiplier = 1.0;

    fatigueRateMultiplier = 1.00;

    fatigueSpeedImpact = 0.50;
}

updateHumanTwinState();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779185287904</Id>
					<Name><![CDATA[updateHumanTwinState]]></Name>
					<X>1040</X><Y>448</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double safeHy = main.Hy;

if (safeHy <= 0) {
    safeHy = 0.80;
}

// Physiological risk.
fatigueRiskScore = Math.max(0.0, Math.min(1.0, fatigue));

// Critical-threshold proximity.
thresholdRiskScore = Math.max(0.0, Math.min(1.0, fatigue / safeHy));

// Sustained-work risk.
workRiskScore = Math.max(0.0, Math.min(1.0, workTime / 120.0));

// Fatigue-related productivity risk.
productivityRiskScore = Math.max(
    0.0,
    Math.min(1.0, (fatigue * fatigueSpeedImpact) / 0.70)
);

recoveryRiskScore = 0.0;

// Weighted Human Digital Twin risk.
totalHumanRiskScore =
    0.50 * fatigueRiskScore +
    0.25 * thresholdRiskScore +
    0.15 * workRiskScore +
    0.10 * productivityRiskScore;

humanTwinHealthScore = 100.0 * (1.0 - totalHumanRiskScore);
humanTwinHealthScore = Math.max(0.0, Math.min(100.0, humanTwinHealthScore));

if (humanTwinHealthScore >= 80.0) {
    humanTwinRiskLevel = "healthy";
}
else if (humanTwinHealthScore >= 60.0) {
    humanTwinRiskLevel = "stable";
}
else if (humanTwinHealthScore >= 40.0) {
    humanTwinRiskLevel = "warning";
}
else if (humanTwinHealthScore >= 20.0) {
    humanTwinRiskLevel = "high_risk";
}
else {
    humanTwinRiskLevel = "critical";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779968098080</Id>
					<Name><![CDATA[updateShiftTracking]]></Name>
					<X>800</X><Y>322</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int currentShiftID = main.getCurrentShiftID();

if (lastTrackedShiftID != currentShiftID) {
    // A merged fixed schedule defines its own episode boundaries.
    if (main.experimentMode == 2 && main.useFixedTaskSchedule) {
        lastTrackedShiftID = currentShiftID;
        return;
    }

    tdNormCumsumCurrentShift = 0.0;
    hadBreakSinceLastJob = 0;
    lastJobHadBreak = 0;
    lastRecoveryTime = currentShiftID * main.standardShiftHours * 60.0;
    lastTrackedShiftID = currentShiftID;

    // Exploration shifts start from a rested state.
      if (main.experimentMode == 2) {
          fatigue = 0.0;
          workTime = 0.0;
          breakTime = 0.0;
          idleTime = 0.0;
          onBreak = false;
          isWorking = false;
          updateHumanTwinState();
          main.traceln(
              "SHIFT RESET | " +
              "Operator" + stationName +
              " | shift=" +
              currentShiftID +
              " | time=" +
              main.roundToDecimal(main.time(), 3) +
              " min"
          );
      }
}]]></Body>
				</Function>
