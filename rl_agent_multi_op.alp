				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778073324568</Id>
					<Name><![CDATA[getTimeToReachHy]]></Name>
					<X>200</X><Y>2172</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[currentFatigue]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (currentOperator == null) {
    return 0.0;
}

double f = currentFatigue;

if (f >= Hy) {
    return 0.0;
}

double shiftProgress = 0.0;

if (standardShiftHours > 0.0) {
    shiftProgress = getElapsedShiftHours() / standardShiftHours;
}

shiftProgress = Math.max(0.0, Math.min(1.0, shiftProgress));

double shiftTimeMultiplier = 1.0 + 0.05 * shiftProgress;
double effectiveLambda =
    currentOperator.lambda *
    currentOperator.fatigueRateMultiplier *
    shiftTimeMultiplier;

if (effectiveLambda <= 0.0) {
    return 999.0;
}

f = Math.max(0.0, Math.min(0.999999, f));

double timeToHySeconds =
    -Math.log((1.0 - Hy) / (1.0 - f)) / effectiveLambda;

return Math.max(0.0, timeToHySeconds / 60.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1778073374678</Id>
					<Name><![CDATA[getFatigueRegion]]></Name>
					<X>200</X><Y>2207</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[currentFatigue]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (currentFatigue < Hx) {
    return "A";
} 
else if (currentFatigue < Hy) {
    return "B";
} 
else {
    return "C";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1783000020013</Id>
					<Name><![CDATA[peekNextScheduledRowForOperator]]></Name>
					<X>500</X><Y>1612</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[operatorName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (fixedTaskSchedule.isEmpty()) {
    loadFixedTaskSchedule();
}

if (fixedTaskSchedule.isEmpty()) {
    return new String[] {"", "task_idle", "0.0", "0.0", "0.0"};
}

int startIndex = fixedTaskScheduleIndexByOperator.containsKey(operatorName)
    ? fixedTaskScheduleIndexByOperator.get(operatorName)
    : 0;

for (int candidateIndex = startIndex;
     candidateIndex < fixedTaskSchedule.size();
     candidateIndex++) {
    String[] candidate = fixedTaskSchedule.get(candidateIndex);

    if (operatorName.equals(candidate[0])) {
        return candidate;
    }
}

return new String[] {"", "task_idle", "0.0", "0.0", "0.0"};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1789000040004</Id>
					<Name><![CDATA[peekSecondScheduledRowForOperator]]></Name>
					<X>500</X><Y>1647</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[operatorName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (fixedTaskSchedule.isEmpty()) {
    loadFixedTaskSchedule();
}

int startIndex = fixedTaskScheduleIndexByOperator.containsKey(operatorName)
    ? fixedTaskScheduleIndexByOperator.get(operatorName)
    : 0;
int matchingRows = 0;

for (int candidateIndex = startIndex;
     candidateIndex < fixedTaskSchedule.size();
     candidateIndex++) {
    String[] candidate = fixedTaskSchedule.get(candidateIndex);

    if (!operatorName.equals(candidate[0])) {
        continue;
    }

    if (matchingRows == 1) {
        return candidate;
    }
    matchingRows++;
}

return new String[] {"", "task_idle", "0.0", "0.0", "0.0"};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789000040001</Id>
					<Name><![CDATA[getTimeToNextScheduledIdle]]></Name>
					<X>500</X><Y>1682</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[op]]></Name>
						<Type><![CDATA[Operator]]></Type>
					</Parameter>
					<Body><![CDATA[if (op == null) {
    return 600.0;
}

String operatorName = getOperatorFullName(op);
int startIndex = fixedTaskScheduleIndexByOperator.containsKey(operatorName)
    ? fixedTaskScheduleIndexByOperator.get(operatorName)
    : 0;
double elapsedMinutes = 0.0;

for (int index = startIndex; index < fixedTaskSchedule.size(); index++) {
    String[] row = fixedTaskSchedule.get(index);

    if (!operatorName.equals(row[0])) {
        continue;
    }
    if ("idle".equals(row[1])) {
        return elapsedMinutes;
    }

    elapsedMinutes += Math.max(0.0, Double.parseDouble(row[2]));
}

return 600.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
